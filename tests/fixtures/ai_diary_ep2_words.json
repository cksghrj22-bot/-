{
  "words": [
    {"start": 7.61, "end": 10.40, "text": "AI한테 일 시키고 제가 다시 다 봤어요"},
    {"start": 10.70, "end": 12.15, "text": "그럼 두 번 일한 거잖아요"},
    {"start": 12.55, "end": 13.75, "text": "그래서 이렇게 바꿨어요"},
    {"start": 14.20, "end": 16.90, "text": "영상 하나 만들 때 지켜야 할 게 몇 개 있어요"},
    {"start": 17.45, "end": 18.75, "text": "길이는 몇 초까지"},
    {"start": 18.95, "end": 20.00, "text": "자막은 어디까지"},
    {"start": 20.45, "end": 22.65, "text": "전에는 이걸 문서에 적어놨어요"},
    {"start": 23.00, "end": 25.70, "text": "적어두면 지킬 줄 알았는데 계속 어기더라고요"},
    {"start": 26.55, "end": 28.20, "text": "그래서 검사하는 걸 만들었어요"},
    {"start": 28.65, "end": 31.10, "text": "영상이 다 만들어지면 자동으로 한 번 훑어요"},
    {"start": 33.30, "end": 34.75, "text": "길이가 넘으면 걸리고"},
    {"start": 35.00, "end": 36.60, "text": "자막이 아래로 내려가면 걸려요"},
    {"start": 36.90, "end": 38.40, "text": "걸리면 아예 안 나와요"},
    {"start": 38.85, "end": 40.55, "text": "어제 그게 열 컷을 잡았어요"},
    {"start": 40.95, "end": 42.45, "text": "제 눈으로 못 봤던 거예요"},
    {"start": 42.95, "end": 45.30, "text": "이제 저는 검사를 통과한 것만 제가 따로 볼 수 있습니다"},
    {"start": 45.60, "end": 46.95, "text": "이렇게 적용해 보세요"}
  ]
}
